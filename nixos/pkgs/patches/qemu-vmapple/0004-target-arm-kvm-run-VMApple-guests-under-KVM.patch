 hw/vmapple/vmapple.c     |  47 ++++++-
 target/arm/kvm-vmapple.c | 260 +++++++++++++++++++++++++++++++++++++++
 target/arm/kvm.c         |  12 ++
 target/arm/kvm_arm.h     |   8 ++
 target/arm/meson.build   |   2 +-
 6 files changed, 325 insertions(+), 6 deletions(-)
 create mode 100644 target/arm/kvm-vmapple.c

