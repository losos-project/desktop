From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matus <dichhead@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:14:42 +0000
Subject: [PATCH 2/3] target/arm: add an apple-m1 CPU model for VMApple guests
 under TCG

---
 target/arm/tcg/cpu64.c | 119 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 119 insertions(+)

diff --git a/target/arm/tcg/cpu64.c b/target/arm/tcg/cpu64.c
index 8a3ebf6321..1ca4930354 100644
--- a/target/arm/tcg/cpu64.c
+++ b/target/arm/tcg/cpu64.c
@@ -534,6 +534,124 @@ static void aarch64_a64fx_initfn(Object *obj)
     /* TODO:  Add A64FX specific HPC extension registers */
 }
 
+/*
+ * An M1's performance core (Firestorm, t8103) as a VMApple guest sees it.
+ * The features are the ones macOS reports on an M1 (sysctl
+ * hw.optional.arm.FEAT_*, macOS 13): ARMv8.5 without BTI, SPECRES, BF16,
+ * I8MM, PAuth2 or FPAC, and with ECV and LSE2.  XNU's VMAPPLE kernel also
+ * takes TLBI by range for granted (__ARM_RANGE_TLBI__), and probes SME and
+ * SSBS at run time, so a TCG "max" CPU would hand a macOS 15 or later guest
+ * SME, SVE and MTE that no M1 ever had.  The PMU stays PMUv3, which is what
+ * the guest booted with under TCG; Apple's own counters are not modelled.
+ */
+static void aarch64_apple_m1_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+    ARMISARegisters *isar = &cpu->isar;
+    uint64_t t;
+
+    set_feature(&cpu->env, ARM_FEATURE_V8);
+    set_feature(&cpu->env, ARM_FEATURE_NEON);
+    set_feature(&cpu->env, ARM_FEATURE_GENERIC_TIMER);
+    set_feature(&cpu->env, ARM_FEATURE_AARCH64);
+    set_feature(&cpu->env, ARM_FEATURE_EL2);
+    set_feature(&cpu->env, ARM_FEATURE_PMU);
+
+    /* Implementer 'a', variant 1, part 0x023 (t8103 Firestorm), revision 1 */
+    cpu->midr = 0x611f0231;
+    cpu->revidr = 0;
+    /* 128-byte lines, PIPT instruction cache */
+    cpu->ctr = 0x8555c005;
+    cpu->reset_sctlr = 0x30c50838;
+    set_dczid_bs(cpu, 4); /* 64 bytes */
+
+    /* L1 split, L2 unified and shared by the cluster */
+    SET_IDREG(isar, CLIDR, 0x0a200023);
+    cpu->ccsidr[0] = make_ccsidr(CCSIDR_FORMAT_LEGACY, 8, 128, 128 * KiB, 7);
+    cpu->ccsidr[1] = make_ccsidr(CCSIDR_FORMAT_LEGACY, 6, 128, 192 * KiB, 2);
+    cpu->ccsidr[2] = make_ccsidr(CCSIDR_FORMAT_LEGACY, 12, 128, 12 * MiB, 7);
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64PFR0, EL0, 1);       /* AArch64 only */
+    t = FIELD_DP64(t, ID_AA64PFR0, EL1, 1);
+    t = FIELD_DP64(t, ID_AA64PFR0, EL2, 1);
+    t = FIELD_DP64(t, ID_AA64PFR0, FP, 1);        /* FEAT_FP16 */
+    t = FIELD_DP64(t, ID_AA64PFR0, ADVSIMD, 1);   /* FEAT_FP16 */
+    t = FIELD_DP64(t, ID_AA64PFR0, DIT, 1);       /* FEAT_DIT */
+    t = FIELD_DP64(t, ID_AA64PFR0, CSV2, 1);      /* FEAT_CSV2 */
+    t = FIELD_DP64(t, ID_AA64PFR0, CSV3, 1);      /* FEAT_CSV3 */
+    SET_IDREG(isar, ID_AA64PFR0, t);              /* GIC filled in later */
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64PFR1, SSBS, 2);      /* FEAT_SSBS2 */
+    SET_IDREG(isar, ID_AA64PFR1, t);
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64ISAR0, AES, 2);      /* FEAT_PMULL */
+    t = FIELD_DP64(t, ID_AA64ISAR0, SHA1, 1);     /* FEAT_SHA1 */
+    t = FIELD_DP64(t, ID_AA64ISAR0, SHA2, 2);     /* FEAT_SHA512 */
+    t = FIELD_DP64(t, ID_AA64ISAR0, CRC32, 1);    /* FEAT_CRC32 */
+    t = FIELD_DP64(t, ID_AA64ISAR0, ATOMIC, 2);   /* FEAT_LSE */
+    t = FIELD_DP64(t, ID_AA64ISAR0, RDM, 1);      /* FEAT_RDM */
+    t = FIELD_DP64(t, ID_AA64ISAR0, SHA3, 1);     /* FEAT_SHA3 */
+    t = FIELD_DP64(t, ID_AA64ISAR0, DP, 1);       /* FEAT_DotProd */
+    t = FIELD_DP64(t, ID_AA64ISAR0, FHM, 1);      /* FEAT_FHM */
+    t = FIELD_DP64(t, ID_AA64ISAR0, TS, 2);       /* FEAT_FlagM2 */
+    t = FIELD_DP64(t, ID_AA64ISAR0, TLB, 2);      /* FEAT_TLBIRANGE */
+    SET_IDREG(isar, ID_AA64ISAR0, t);
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64ISAR1, DPB, 2);      /* FEAT_DPB2 */
+    t = FIELD_DP64(t, ID_AA64ISAR1, API, 1);      /* FEAT_PAuth, Apple's */
+    t = FIELD_DP64(t, ID_AA64ISAR1, JSCVT, 1);    /* FEAT_JSCVT */
+    t = FIELD_DP64(t, ID_AA64ISAR1, FCMA, 1);     /* FEAT_FCMA */
+    t = FIELD_DP64(t, ID_AA64ISAR1, LRCPC, 2);    /* FEAT_LRCPC2 */
+    t = FIELD_DP64(t, ID_AA64ISAR1, GPI, 1);
+    t = FIELD_DP64(t, ID_AA64ISAR1, FRINTTS, 1);  /* FEAT_FRINTTS */
+    t = FIELD_DP64(t, ID_AA64ISAR1, SB, 1);       /* FEAT_SB */
+    SET_IDREG(isar, ID_AA64ISAR1, t);
+
+    t = 0;
+    /* 36-bit addresses, as Apple's hypervisor gives a guest on an M1 */
+    t = FIELD_DP64(t, ID_AA64MMFR0, PARANGE, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR0, ASIDBITS, 2);
+    t = FIELD_DP64(t, ID_AA64MMFR0, TGRAN16, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR0, TGRAN64, 0xf); /* no 64K pages */
+    t = FIELD_DP64(t, ID_AA64MMFR0, TGRAN4, 0);
+    t = FIELD_DP64(t, ID_AA64MMFR0, ECV, 1);      /* FEAT_ECV */
+    SET_IDREG(isar, ID_AA64MMFR0, t);
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64MMFR1, VMIDBITS, 2);
+    t = FIELD_DP64(t, ID_AA64MMFR1, VH, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR1, HPDS, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR1, LO, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR1, PAN, 2);      /* FEAT_PAN2, no EPAN */
+    t = FIELD_DP64(t, ID_AA64MMFR1, XNX, 1);
+    SET_IDREG(isar, ID_AA64MMFR1, t);
+
+    t = 0;
+    t = FIELD_DP64(t, ID_AA64MMFR2, CNP, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR2, UAO, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR2, ST, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR2, AT, 1);       /* FEAT_LSE2 */
+    t = FIELD_DP64(t, ID_AA64MMFR2, IDS, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR2, TTL, 1);
+    t = FIELD_DP64(t, ID_AA64MMFR2, E0PD, 1);
+    SET_IDREG(isar, ID_AA64MMFR2, t);
+
+    SET_IDREG(isar, ID_AA64DFR0, 0x0000000010305106ull); /* PMUv3, as A57 */
+
+    cpu->gic_num_lrs = 4;
+    cpu->gic_vpribits = 5;
+    cpu->gic_vprebits = 5;
+    cpu->gic_pribits = 5;
+
+    cpu->isar.reset_pmcr_el0 = 0x61003000;
+
+    aarch64_add_pauth_properties(obj);
+}
+
 static CPAccessResult access_actlr_w(CPUARMState *env, const ARMCPRegInfo *r,
                                      bool read)
 {
@@ -1446,6 +1564,7 @@ void aarch64_max_tcg_initfn(Object *obj)
 }
 
 static const ARMCPUInfo aarch64_cpus[] = {
+    { .name = "apple-m1",           .initfn = aarch64_apple_m1_initfn },
     { .name = "cortex-a35",         .initfn = aarch64_a35_initfn },
     { .name = "cortex-a55",         .initfn = aarch64_a55_initfn },
     { .name = "cortex-a72",         .initfn = aarch64_a72_initfn },
