@@ -721,6 +721,20 @@ typedef struct CPUArchState {
         ARMPACKey apga;
     } keys;
 
+    /*
+     * Apple's paravirtual pointer authentication, as VMApple guests see
+     * it.  The guest never writes the key registers itself; it asks the
+     * hypervisor through the hypercalls in target/arm/tcg/apple-pac.c.
+     * Besides the architected A, B and G keys there is one more key, the
