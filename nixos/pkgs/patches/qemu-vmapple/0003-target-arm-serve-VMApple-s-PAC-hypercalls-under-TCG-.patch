+    /*
+     * Serve the VMApple PAC hypercalls and give EL0 its diversified keys
+     * (env->apple_pac).  Set by the vmapple machine under TCG.
+     */
+    bool apple_pac;
     bool prop_lpa2;
 
     /* GM blocksize, in log_2(words), ie low 4 bits of GMID_EL0 */
