diff --git a/target/arm/tcg/pauth_helper.c b/target/arm/tcg/pauth_helper.c
index a7b24ae124..78b0362b88 100644
--- a/target/arm/tcg/pauth_helper.c
+++ b/target/arm/tcg/pauth_helper.c
@@ -336,8 +336,32 @@ static uint64_t pauth_computepac(CPUARMState *env, uint64_t data,
     }
 }
 
+/*
+ * The key an A or B instruction really uses on a VMApple CPU.  EL0, and
+ * EL1 while the kernel borrows a process's keys, mix in the EL0
+ * diversifier (target/arm/tcg/apple-pac.c), so a pointer EL0 signed does
+ * not authenticate at EL1 and the other way round.
+ */
+static const ARMPACKey *pauth_apple_key(CPUARMState *env,
+                                        const ARMPACKey *key,
+                                        ARMPACKey *mixed)
+{
+    int el;
+
+    if (!env_archcpu(env)->apple_pac) {
+        return key;
+    }
+    el = arm_current_el(env);
+    if (el != 0 && !(el == 1 && env->apple_pac.el0_key_at_el1)) {
+        return key;
+    }
+    mixed->lo = key->lo ^ env->apple_pac.el0_key.lo;
+    mixed->hi = key->hi ^ env->apple_pac.el0_key.hi;
+    return mixed;
+}
+
 static uint64_t pauth_addpac(CPUARMState *env, uint64_t ptr, uint64_t modifier,
-                             ARMPACKey *key, bool data)
+                             const ARMPACKey *key, bool data)
 {
     ARMCPU *cpu = env_archcpu(env);
     ARMMMUIdx mmu_idx = arm_stage1_mmu_idx(env);
@@ -345,6 +369,7 @@ static uint64_t pauth_addpac(CPUARMState *env, uint64_t ptr, uint64_t modifier,
     ARMPauthFeature pauth_feature = cpu_isar_feature(pauth_feature, cpu);
     uint64_t pac, ext_ptr, ext, test;
     int bot_bit, top_bit;
+    ARMPACKey mixed;
 
     /* If tagged pointers are in use, use ptr<55>, otherwise ptr<63>.  */
     if (param.tbi) {
@@ -365,7 +390,8 @@ static uint64_t pauth_addpac(CPUARMState *env, uint64_t ptr, uint64_t modifier,
         ext_ptr = deposit64(ext_ptr, 60, 4, ext);
     }
 
-    pac = pauth_computepac(env, ext_ptr, modifier, *key);
+    pac = pauth_computepac(env, ext_ptr, modifier,
+                           *pauth_apple_key(env, key, &mixed));
 
     /*
      * Check if the ptr has good extension bits and corrupt the
@@ -430,7 +456,7 @@ void pauth_fail_exception(CPUARMState *env, bool data,
 }
 
 static uint64_t pauth_auth(CPUARMState *env, uint64_t ptr, uint64_t modifier,
-                           ARMPACKey *key, bool data, int keynumber,
+                           const ARMPACKey *key, bool data, int keynumber,
                            uintptr_t ra, bool is_combined)
 {
     ARMCPU *cpu = env_archcpu(env);
@@ -439,6 +465,7 @@ static uint64_t pauth_auth(CPUARMState *env, uint64_t ptr, uint64_t modifier,
     ARMPauthFeature pauth_feature = cpu_isar_feature(pauth_feature, cpu);
     int bot_bit, top_bit;
     uint64_t pac, orig_ptr, cmp_mask;
+    ARMPACKey mixed;
 
     orig_ptr = pauth_original_ptr(ptr, param);
 
@@ -451,7 +478,8 @@ static uint64_t pauth_auth(CPUARMState *env, uint64_t ptr, uint64_t modifier,
         return orig_ptr;
     }
 
-    pac = pauth_computepac(env, orig_ptr, modifier, *key);
+    pac = pauth_computepac(env, orig_ptr, modifier,
+                           *pauth_apple_key(env, key, &mixed));
     bot_bit = 64 - param.tsz;
     top_bit = 64 - 8 * param.tbi;
 
diff --git a/target/arm/tcg/psci.c b/target/arm/tcg/psci.c
index 56754bde95..3b14bc61a6 100644
--- a/target/arm/tcg/psci.c
+++ b/target/arm/tcg/psci.c
@@ -83,6 +83,12 @@ void arm_handle_psci_call(ARMCPU *cpu)
     trace_arm_psci_call(param[0], param[1], param[2], param[3],
                         arm_cpu_mp_affinity(cpu));
 
+    /* The same conduit carries Apple's PAC service on a VMApple machine. */
+    if (is_a64(env) && arm_is_apple_pac_call(cpu, param[0])) {
+        arm_handle_apple_pac_call(cpu);
+        return;
+    }
+
     if ((param[0] & QEMU_PSCI_0_2_64BIT) && !is_a64(env)) {
         ret = QEMU_PSCI_RET_NOT_SUPPORTED;
         goto err;
