diff --git a/target/arm/tcg/apple-pac.c b/target/arm/tcg/apple-pac.c
new file mode 100644
index 0000000000..394c4b83fa
--- /dev/null
+++ b/target/arm/tcg/apple-pac.c
@@ -0,0 +1,135 @@
+/*
+ * Apple's paravirtual pointer authentication for VMApple guests under TCG
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * An arm64 macOS guest of Apple's hypervisor never programs its pointer
+ * authentication keys.  XNU's VMAPPLE kernel (HAS_PARAVIRTUALIZED_PAC)
+ * asks for them through the "Apple CPU service" hypercalls instead, and
+ * from macOS 26 on it spins on "cbnz x0, ." when one does not return 0.
+ * The function numbers and registers are XNU's (osfmk/arm64/hv_hvc.h,
+ * pac_asm.h, machine_routines_asm.s); the default keys and the way a key
+ * fills its register group (x, x+1, ...) are what Apple's hypervisor was
+ * seen to do on Asahi Linux KVM (aquarat/qemu-reims-vgpu, kvm-vmapple.c).
+ *
+ *   0x00  SET_INITIAL_STATE       all keys to their defaults, EL1 keys
+ *   0x01  GET_DEFAULT_KEYS        A, B, EL0 and G defaults in x1..x4
+ *   0x02  SET_A_KEYS     x1       APIA, APDA from x1
+ *   0x03  SET_B_KEYS     x1       APIB, APDB from x1 (each thread's ROP key)
+ *   0x04  SET_EL0_DIVERSIFIER x1  EL0's own A and B keys (its JOP key)
+ *   0x05  SET_EL0_DIVERSIFIER_AT_EL1 x1, x2
+ *                                 the EL0 key from x2, and whether EL1
+ *                                 uses it too (x1), so the kernel can sign
+ *                                 a process's pointers for it
+ *   0x06  SET_G_KEY      x1       APGA from x1
+ *   0xf0  NOP                     probed to tell a current host from an
+ *                                 old one; an old one answers 0xffffffff
+ *
+ * On Apple silicon the EL0 key is the KERNKEY register pair and APCTL
+ * says which exception levels mix it in (Asahi's register notes,
+ * m1n1 hv_sprr.c).  The cipher itself is Apple's and nobody outside has
+ * it, so pauth_helper.c mixes the EL0 key into QEMU's own algorithm.  A
+ * guest cannot tell: it only ever compares signatures this CPU made.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "cpu.h"
+#include "internals.h"
+
+#define APPLE_PAC_SERVICE   0xc1000000ULL
+#define APPLE_PAC_FN_MASK   0xffULL
+
+enum {
+    APPLE_PAC_SET_INITIAL_STATE = 0x00,
+    APPLE_PAC_GET_DEFAULT_KEYS = 0x01,
+    APPLE_PAC_SET_A_KEYS = 0x02,
+    APPLE_PAC_SET_B_KEYS = 0x03,
+    APPLE_PAC_SET_EL0_DIVERSIFIER = 0x04,
+    APPLE_PAC_SET_EL0_DIVERSIFIER_AT_EL1 = 0x05,
+    APPLE_PAC_SET_G_KEY = 0x06,
+    APPLE_PAC_NOP = 0xf0,
+};
+
+/* SMCCC's NOT_SUPPORTED, as a 64-bit return. */
+#define SMCCC_NOT_SUPPORTED ((uint64_t)-1)
+
+/* Every default key is an offset from one constant, as on Apple's host. */
+#define APPLE_PAC_KEY_BASE 0xfeedfacefeedfacfULL
+#define APPLE_PAC_DEFAULT_A   (APPLE_PAC_KEY_BASE + 6)
+#define APPLE_PAC_DEFAULT_B   (APPLE_PAC_KEY_BASE + 0)
+#define APPLE_PAC_DEFAULT_EL0 (APPLE_PAC_KEY_BASE + 4)
+#define APPLE_PAC_DEFAULT_G   (APPLE_PAC_KEY_BASE + 10)
+
+bool arm_is_apple_pac_call(ARMCPU *cpu, uint64_t fid)
+{
+    return cpu->apple_pac && (fid & ~APPLE_PAC_FN_MASK) == APPLE_PAC_SERVICE;
+}
+
+static void set_pair(ARMPACKey *key, uint64_t seed)
+{
+    key->lo = seed;
+    key->hi = seed + 1;
+}
+
+static void set_a_keys(CPUARMState *env, uint64_t seed)
+{
+    set_pair(&env->keys.apia, seed);
+    set_pair(&env->keys.apda, seed + 2);
+}
+
+static void set_b_keys(CPUARMState *env, uint64_t seed)
+{
+    set_pair(&env->keys.apib, seed);
+    set_pair(&env->keys.apdb, seed + 2);
+}
+
+void arm_handle_apple_pac_call(ARMCPU *cpu)
+{
+    CPUARMState *env = &cpu->env;
+    unsigned fn = env->xregs[0] & APPLE_PAC_FN_MASK;
+    uint64_t x1 = env->xregs[1];
+    uint64_t x2 = env->xregs[2];
+    uint64_t ret = 0;
+
+    switch (fn) {
+    case APPLE_PAC_SET_INITIAL_STATE:
+        set_a_keys(env, APPLE_PAC_DEFAULT_A);
+        set_b_keys(env, APPLE_PAC_DEFAULT_B);
+        set_pair(&env->keys.apga, APPLE_PAC_DEFAULT_G);
+        set_pair(&env->apple_pac.el0_key, APPLE_PAC_DEFAULT_EL0);
+        env->apple_pac.el0_key_at_el1 = false;
+        break;
+    case APPLE_PAC_GET_DEFAULT_KEYS:
+        /* XNU keeps x2 as its default ROP key and x3 as its JOP key. */
+        env->xregs[1] = APPLE_PAC_DEFAULT_A;
+        env->xregs[2] = APPLE_PAC_DEFAULT_B;
+        env->xregs[3] = APPLE_PAC_DEFAULT_EL0;
+        env->xregs[4] = APPLE_PAC_DEFAULT_G;
+        break;
+    case APPLE_PAC_SET_A_KEYS:
+        set_a_keys(env, x1);
+        break;
+    case APPLE_PAC_SET_B_KEYS:
+        set_b_keys(env, x1);
+        break;
+    case APPLE_PAC_SET_EL0_DIVERSIFIER:
+        set_pair(&env->apple_pac.el0_key, x1);
+        break;
+    case APPLE_PAC_SET_EL0_DIVERSIFIER_AT_EL1:
+        set_pair(&env->apple_pac.el0_key, x2);
+        env->apple_pac.el0_key_at_el1 = x1 != 0;
+        break;
+    case APPLE_PAC_SET_G_KEY:
+        set_pair(&env->keys.apga, x1);
+        break;
+    case APPLE_PAC_NOP:
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "Apple PAC hypercall %#" PRIx64
+                      " not implemented\n", env->xregs[0]);
+        ret = SMCCC_NOT_SUPPORTED;
+        break;
+    }
+    env->xregs[0] = ret;
+}
