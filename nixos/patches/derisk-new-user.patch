+#[test]
+fn machine_apps_outrank_an_equal_host_hit_and_updates_outrank_the_store() {
+    let host = palette::Entry::new(palette::Category::App, "t", "Terminal", Vec::new())
+        .detail("Use the command line");
+    let machine = palette::Entry::new(
+        palette::Category::App,
+        "c",
+        "Terminal in flatpak",
+        Vec::new(),
+    )
+    .detail("Opens in the flatpak machine")
+    .keywords("machine vm");
+    let power = palette::Entry::new(
+        palette::Category::Command,
+        "p",
+        "Power Mode: Power saver",
+        Vec::new(),
+    )
+    .detail("Switch the whole computer to it");
+    let store = palette::Entry::new(palette::Category::App, "s", "Store", Vec::new())
+        .detail("Find, install and update apps from Flathub")
+        .keywords("updates");
+    let system = palette::Entry::new(
+        palette::Category::AppAction,
+        "u",
+        "System and Updates",
+        Vec::new(),
+    )
+    .detail("Settings")
+    .keywords("update updates release");
+
+    let entries = vec![store.clone(), host.clone(), power.clone(), machine.clone(), system.clone()];
+    let titles = |q: &str| titles(&entries, &palette::search(&entries, q, &History::default()));
+
+    let term = titles("term");
+    assert_eq!(term[0], "Terminal in flatpak", "{term:?}");
+    assert!(term.iter().any(|t| t == "Terminal"));
+    assert!(!titles("mach").iter().any(|t| t.starts_with("Power Mode")));
+
+    let updates = titles("updates");
+    assert_eq!(updates[0], "System and Updates", "{updates:?}");
+    assert!(updates.iter().any(|t| t == "Store"));
+}
