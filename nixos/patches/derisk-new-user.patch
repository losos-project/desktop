index 29e9f65..4ebb21d 100644
--- a/crates/derisk/src/palette.rs
+++ b/crates/derisk/src/palette.rs
@@ -889,8 +889,23 @@ pub fn search(entries: &[Entry], query: &str, history: &History) -> Vec<usize> {
         })
         .filter_map(|(i, e)| score(e, query).map(|s| (s + history.boost(e), i)))
         .collect();
-    // Higher score first; ties keep catalog order (apps, windows, commands, ...).
-    hits.sort_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)));
+    // Higher score first. A tie prefers a machine's app over a host app
+    // listed earlier: both titles can start with the same word ("Terminal"
+    // and "Terminal in flatpak"), and catalog order would hide the machine.
+    // Anything still tied keeps catalog order.
+    hits.sort_by(|a, b| {
+        b.0.cmp(&a.0).then_with(|| {
+            let machine = |i: usize| {
+                entries[i].keywords.split_whitespace().any(|k| k == "machine")
+                    || entries[i].title.contains(" in ")
+            };
+            match (machine(a.1), machine(b.1)) {
+                (true, false) => std::cmp::Ordering::Less,
+                (false, true) => std::cmp::Ordering::Greater,
+                _ => a.1.cmp(&b.1),
+            }
+        })
+    });
     hits.into_iter().map(|(_, i)| i).collect()
 }
 
