+/// What the bar says once a machine that just started has listed its apps.
+pub(crate) fn started_after_apps(
+    name: &str,
+    apps: &Result<Vec<crate::GuestApp>, String>,
+) -> Result<String, String> {
+    match apps {
+        Ok(_) => Ok(format!("Started {name}")),
+        Err(error) => {
+            Err(format!("{name} is running, but its apps could not be listed: {error}"))
+        }
+    }
+}
