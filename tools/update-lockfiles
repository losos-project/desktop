#!/usr/bin/env bash
# Move every lockfile this repository owns to what its manifests allow now,
# and re-pin the fixed-output hashes that follow from them. The `lockfiles`
# workflow runs it weekly and pushes the result to main (docs/trust.md,
# "Keeping the pins current").
#
#   tools/update-lockfiles > summary.md
#
# - flake.lock: nixpkgs and Home Manager (`nix flake update`, named, so the
#   component inputs below are not touched a second way).
# - Every Cargo.lock: `cargo update`, which stays within the versions each
#   Cargo.toml allows, so no manifest changes.
# - Every package-lock.json: `npm update --package-lock-only`, the same.
# - tools/update-packages: the custom packages whose upstreams move on
#   their own schedule, each pin bumped forward only with the hash its
#   upstream source lists.
# - Then tools/nix-refresh-hashes, for losos-docs' npm deps and anything
#   else whose fetch the above changed.
#
# - The component inputs derisk, mcsapi and pm (flake.nix): derisk and pm to
#   each repository's newest weekly release, which that repository cut at
#   02:17 UTC the same day (its .github/release); mcsapi to the revision
#   derisk's Cargo.lock names at that release, so the two agree (docs/
#   trust.md, "The component inputs"). A pin only moves forward: one someone
#   moved past the release by hand stays. Nothing else in those repositories
#   moves here, since each updates its own lockfiles the same way. This
#   needs gh and a token for the release and compare APIs; without them the
#   pins stay where they are.
#
# cargo and npm come from the updated nixpkgs, so a lock is resolved by the
# toolchain that will build it. Progress goes to stderr; stdout is a
# Markdown summary.
set -euo pipefail

[ $# = 0 ] || { sed -n 's/^#   //p' "$0" >&2; exit 2; }
cd "$(git rev-parse --show-toplevel)"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo "Listing the pinned fixed outputs before anything moves" >&2
tools/nix-refresh-hashes --list > "$work/before"

# "<owner>/<repo>" of a component input, from the URL flake.lock records for
# it.
repository() {
  # flake.lock's top-level `root` is the string "root"; the inputs map
  # lives under nodes.root.inputs.
  jq -r --arg n "$1" '.nodes[.nodes.root.inputs[$n]].original.url' flake.lock |
    sed -E 's|^https://github.com/||; s|\.git$||'
}

# The revision flake.lock pins a component input at.
pinned_rev() {
  jq -r --arg n "$1" '.nodes[.nodes.root.inputs[$n]].locked.rev' flake.lock
}

# Moves the flake input NAME to REV, which LABEL describes, when REV is
# newer than the pin. GitHub's compare says which way REV lies from the pin;
# a pin on a commit main does not hold ("diverged") is someone's on purpose,
# so it stays.
: > "$work/inputs"
move_input() {
  local name=$1 rev=$2 label=$3 repo pin status
  repo=$(repository "$name")
  pin=$(pinned_rev "$name")
  [ "$pin" = "$rev" ] && { echo "$name is at $label already" >&2; return 0; }
  if ! status=$(gh api "repos/$repo/compare/$pin...$rev" --jq .status); then
    echo "warning: could not compare $name's pin with $label; it stays" >&2
    return 0
  fi
  if [ "$status" != ahead ]; then
    echo "$name stays at ${pin:0:12}, which $label is not ahead of ($status)" >&2
    return 0
  fi
  echo "$name: ${pin:0:12} to $label" >&2
  # --override-input rewrites the input's lock entry at that revision. The
  # entry's `original` keeps flake.nix's URL, so a later `nix flake update`
  # still reads the branch and not this pin.
  nix flake lock --override-input "$name" "git+https://github.com/$repo?rev=$rev" 2>&1 |
    sed 's/^/nix: /' >&2
  echo "- \`$name\`: \`${pin:0:12}\` to $label" >> "$work/inputs"
}

# The newest weekly release of a component's repository, as "<tag> <commit>".
newest_weekly() {
  local repo tag
  repo=$(repository "$1")
  tag=$(gh release list --repo "$repo" --limit 1000 --exclude-drafts --json tagName \
    --jq '.[].tagName | select(test("^weekly-[0-9]{8}T[0-9]{4}$"))' | sort | tail -n 1)
  [ -n "$tag" ] || return 1
  echo "$tag $(gh api "repos/$repo/commits/$tag" --jq .sha)"
}

if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
  for name in derisk pm; do
    if release=$(newest_weekly "$name"); then
      read -r tag rev <<<"$release"
      move_input "$name" "$rev" "[\`$tag\`](https://github.com/$(repository "$name")/releases/tag/$tag)"
    else
      echo "warning: $(repository "$name") has no weekly release yet; $name stays" >&2
    fi
  done
  # The mcsapi revision derisk's lock fetches, under either name the
  # repository has had, read from derisk's tree at the commit its input is
  # now pinned at.
  rev=$(gh api "repos/$(repository derisk)/contents/Cargo.lock?ref=$(pinned_rev derisk)" \
    --jq .content | base64 -d |
    sed -nE 's|^source = "git\+https://github.com/[^/]+/mcsapi(\?[^#]*)?#([0-9a-f]{40})"$|\2|p' | sort -u)
  if [ "$(grep -c . <<<"$rev")" = 1 ]; then
    move_input mcsapi "$rev" "\`${rev:0:12}\`, the revision derisk's Cargo.lock names"
  else
    echo "warning: derisk's Cargo.lock names ${rev:-no} mcsapi revision(s); mcsapi stays" >&2
  fi
else
  echo "warning: gh is not signed in, so the component pins stay where they are" >&2
fi

nix flake update nixpkgs home-manager 2>&1 | tee "$work/flake" >&2

# `nix shell` evaluates the newly locked nixpkgs, so this runs after the
# flake update.
PATH=$(nix shell --inputs-from . nixpkgs#cargo nixpkgs#nodejs -c printenv PATH)
git ls-files ':(glob)**/Cargo.lock' | while read -r lock; do
  echo "cargo update in ${lock%/*}" >&2
  cargo update --manifest-path "$(dirname "$lock")/Cargo.toml" < /dev/null
done
git ls-files ':(glob)**/package-lock.json' | while read -r lock; do
  echo "npm update in ${lock%/*}" >&2
  (cd "$(dirname "$lock")" && npm update --package-lock-only --ignore-scripts --no-fund --no-audit < /dev/null) >&2
done

# The custom packages' upstreams move without waiting for nixpkgs.
tools/update-packages > "$work/packages"

tools/nix-refresh-hashes "$work/before" | tee "$work/hashes" >&2

# What a reviewer reads first: which inputs moved, how many crates and npm
# packages each lock changed, and which pins were rewritten.
echo "### flake.lock"
echo
# nix prints each input as its name, the old URL and date, then "→" and
# the new URL and date; the dates are what a reader wants.
awk -F"'" '
  /^• Updated input/ { name = $2; from = ""; next }
  name != "" && from == "" { from = $NF; next }
  name != "" { to = $NF; gsub(/[ ()]/, "", from); gsub(/[ ()]/, "", to)
               printf "- `%s`: %s to %s\n", name, from, to; name = "" }
' "$work/flake"
grep -q "Updated input" "$work/flake" || echo "No input moved."
echo
echo "### Cargo.lock and package-lock.json"
echo
git diff --numstat -- ':(glob)**/Cargo.lock' ':(glob)**/package-lock.json' |
  awk '{ printf "- `%s`: +%s -%s lines\n", $3, $1, $2 }'
git diff --quiet -- ':(glob)**/Cargo.lock' ':(glob)**/package-lock.json' && echo "No lock moved."
echo
echo "### Component inputs"
echo
if [ -s "$work/inputs" ]; then cat "$work/inputs"; else echo "No component pin moved."; fi
echo
echo "### Custom packages"
echo
if [ -s "$work/packages" ]; then cat "$work/packages"; else echo "No pin moved."; fi
echo
echo "### Pinned hashes"
echo
grep ' -> ' "$work/hashes" | sed 's/^/- /' || echo "None needed rewriting."
