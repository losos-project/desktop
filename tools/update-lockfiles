#!/usr/bin/env bash
# Move every lockfile this repository owns to what its manifests allow now,
# and re-pin the fixed-output hashes that follow from them. The `lockfiles`
# workflow runs it weekly and pushes the result to main (docs/trust.md,
# "Keeping the pins current").
#
#   tools/update-lockfiles > summary.md
#
# - flake.lock: every input, nixpkgs and Home Manager (`nix flake update`).
# - Every Cargo.lock outside components/: `cargo update`, which stays within
#   the versions each Cargo.toml allows, so no manifest changes.
# - Every package-lock.json: `npm update --package-lock-only`, the same.
# - Then tools/nix-refresh-hashes, for losos-docs' npm deps and anything
#   else whose fetch the above changed.
#
# - components/pm: to its repository's newest weekly release, which that
#   repository cut at 02:17 UTC the same day (its .github/release).
# - nixos/pkgs/derisk-bundle.pin.nix: to the newest weekly derisk release's
#   desktop bundles and version, instead of the components/derisk submodule.
#   components/mcsapi to the revision derisk's Cargo.lock names at that
#   release, so the two agree (docs/trust.md, "The components/ submodules").
#   A pin only moves forward. This needs gh and a token; without them the
#   pins stay where they are.
#
# Inside components/ nothing else moves: each repository updates its own
# lockfiles the same way. cargo and npm come from the updated nixpkgs, so a
# lock is resolved by the toolchain that will build it. Progress goes to
# stderr; stdout is a Markdown summary.
set -euo pipefail

[ $# = 0 ] || { sed -n 's/^#   //p' "$0" >&2; exit 2; }
cd "$(git rev-parse --show-toplevel)"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo "Listing the pinned fixed outputs before anything moves" >&2
tools/nix-refresh-hashes --list > "$work/before"

# "<owner>/<repo>" of a submodule, from the URL .gitmodules gives it.
repository() {
  git config -f .gitmodules "submodule.components/$1.url" |
    sed -E 's|^https://github.com/||; s|\.git$||'
}

# Moves components/NAME to REV, which LABEL describes, when REV is newer than
# the pin. GitHub's compare says which way REV lies from the pin; a pin on a
# commit main does not hold ("diverged") is someone's on purpose, so it stays.
: > "$work/submodules"
: > "$work/derisk"
move_submodule() {
  local name=$1 rev=$2 label=$3 repo pin status
  repo=$(repository "$name")
  # Inside a submodule that was never initialised, git would act on this
  # repository instead.
  if [ "$(git -C "components/$name" rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)/components/$name" ]; then
    echo "warning: components/$name is not checked out (git submodule update --init); it stays" >&2
    return 0
  fi
  # The checkout, not the commit recorded here, so a newer commit checked
  # out by hand is not moved back.
  pin=$(git -C "components/$name" rev-parse HEAD)
  [ "$pin" = "$rev" ] && { echo "components/$name is at $label already" >&2; return 0; }
  if ! status=$(gh api "repos/$repo/compare/$pin...$rev" --jq .status); then
    echo "warning: could not compare components/$name with $label; it stays" >&2
    return 0
  fi
  if [ "$status" != ahead ]; then
    echo "components/$name stays at ${pin:0:12}, which $label is not ahead of ($status)" >&2
    return 0
  fi
  echo "components/$name: ${pin:0:12} to $label" >&2
  git -C "components/$name" fetch --quiet --depth=1 origin "$rev"
  git -C "components/$name" checkout --quiet --detach "$rev"
  # The flake reads submodules from the index (self.submodules), so the new
  # pin has to be staged to be evaluated.
  git add "components/$name"
  echo "- \`components/$name\`: \`${pin:0:12}\` to $label" >> "$work/submodules"
}

# The newest weekly release of a submodule's repository, as "<tag> <commit>".
newest_weekly() {
  local repo tag
  repo=$(repository "$1")
  tag=$(gh release list --repo "$repo" --limit 1000 --exclude-drafts --json tagName \
    --jq '.[].tagName | select(test("^weekly-[0-9]{8}T[0-9]{4}$"))' | sort | tail -n 1)
  [ -n "$tag" ] || return 1
  echo "$tag $(gh api "repos/$repo/commits/$tag" --jq .sha)"
}

# Move nixos/pkgs/derisk-bundle.pin.nix to the newest weekly derisk release.
update_derisk_bundle_pin() {
  local repo tag dir bundle version hash
  repo=$(repository derisk)
  if ! release=$(newest_weekly derisk); then
    echo "warning: $repo has no weekly release yet; derisk bundle pin stays" >&2
    return 0
  fi
  read -r tag _ <<<"$release"
  dir="$work/derisk-bundle"
  mkdir -p "$dir"
  gh release download "$tag" --repo "$repo" --dir "$dir" \
    --pattern 'derisk-desktop-*.tar.xz' --pattern 'derisk-*.tar.gz' || {
    echo "warning: $repo $tag has no desktop bundles yet; derisk bundle pin stays" >&2
    return 0
  }
  bundle=$(ls "$dir"/derisk-desktop-x86_64-linux-*.tar.xz 2>/dev/null | head -n 1)
  [ -n "$bundle" ] || {
    echo "warning: $repo $tag has no x86_64 desktop bundle; derisk bundle pin stays" >&2
    return 0
  }
  version=$(basename "$bundle" .tar.xz | sed 's/^derisk-desktop-x86_64-linux-//')
  hash=$(nix hash file --type sha256 "$bundle")
  hash_aarch=$(nix hash file --type sha256 "$dir/derisk-desktop-aarch64-linux-${version}.tar.xz")
  cat > nixos/pkgs/derisk-bundle.pin.nix <<EOF
{
  enable = true;
  repository = "$repo";
  tag = "$tag";
  version = "$version";
  hashes = {
    x86_64-linux = "$hash";
    aarch64-linux = "$hash_aarch";
  };
}
EOF
  git add nixos/pkgs/derisk-bundle.pin.nix
  echo "- derisk bundle: [\`$tag\`](https://github.com/$repo/releases/tag/$tag) (\`$version\`)" >> "$work/derisk"
}

if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
  update_derisk_bundle_pin
  mcsapi_src=$(ls "$work/derisk-bundle"/derisk-*.tar.gz 2>/dev/null | head -n 1)
  mcsapi_rev=
  if [ -n "$mcsapi_src" ]; then
    mcsapi_rev=$(
      tar -xOzf "$mcsapi_src" --wildcards '*/Cargo.lock' 2>/dev/null \
        | sed -nE 's|^source = "git\+https://github.com/[^/]+/mcsapi(\?[^#]*)?#([0-9a-f]{40})"$|\2|p' \
        | sort -u
    )
  fi
  if [ "$(grep -c . <<<"${mcsapi_rev:-}")" = 1 ]; then
    move_submodule mcsapi "$mcsapi_rev" "\`${mcsapi_rev:0:12}\`, the revision derisk release \`$(sed -n 's/.*tag = \"\\([^\"]*\\)\".*/\\1/p' nixos/pkgs/derisk-bundle.pin.nix | head -n1)\`'s Cargo.lock names"
  else
    rev=$(git -C components/derisk show HEAD:Cargo.lock 2>/dev/null |
      sed -nE 's|^source = "git\+https://github.com/[^/]+/mcsapi(\?[^#]*)?#([0-9a-f]{40})"$|\2|p' | sort -u)
    if [ "$(grep -c . <<<"$rev")" = 1 ]; then
      move_submodule mcsapi "$rev" "\`${rev:0:12}\`, the revision components/derisk's Cargo.lock names"
    else
      echo "warning: derisk release names ${mcsapi_rev:-no} mcsapi revision(s); components/mcsapi stays" >&2
    fi
  fi
  for name in pm; do
    if release=$(newest_weekly "$name"); then
      read -r tag rev <<<"$release"
      move_submodule "$name" "$rev" "[\`$tag\`](https://github.com/$(repository "$name")/releases/tag/$tag)"
    else
      echo "warning: $(repository "$name") has no weekly release yet; components/$name stays" >&2
    fi
  done
else
  echo "warning: gh is not signed in, so the submodules stay where they are" >&2
fi

nix flake update 2>&1 | tee "$work/flake" >&2

# `nix shell` evaluates the newly locked nixpkgs, so this runs after the
# flake update.
PATH=$(nix shell --inputs-from . nixpkgs#cargo nixpkgs#nodejs -c printenv PATH)
git ls-files ':(glob)**/Cargo.lock' ':!:components/' | while read -r lock; do
  echo "cargo update in ${lock%/*}" >&2
  cargo update --manifest-path "$(dirname "$lock")/Cargo.toml" < /dev/null
done
git ls-files ':(glob)**/package-lock.json' ':!:components/' | while read -r lock; do
  echo "npm update in ${lock%/*}" >&2
  (cd "$(dirname "$lock")" && npm update --package-lock-only --ignore-scripts --no-fund --no-audit < /dev/null) >&2
done

tools/nix-refresh-hashes "$work/before" | tee "$work/hashes" >&2

# What a reviewer reads first: which inputs moved, how many crates and npm
# packages each lock changed, and which pins were rewritten.
echo "### flake.lock"
echo
# nix prints each input as its name, the old URL and date, then "→" and
# the new URL and date; the dates are what a reader wants.
awk -F"'" '
  /^• Updated input/ { name = $2; from = ""; next }
  name != "" && from == "" { from = $NF; next }
  name != "" { to = $NF; gsub(/[ ()]/, "", from); gsub(/[ ()]/, "", to)
               printf "- `%s`: %s to %s\n", name, from, to; name = "" }
' "$work/flake"
grep -q "Updated input" "$work/flake" || echo "No input moved."
echo
echo "### Cargo.lock and package-lock.json"
echo
git diff --numstat -- ':(glob)**/Cargo.lock' ':(glob)**/package-lock.json' |
  awk '{ printf "- `%s`: +%s -%s lines\n", $3, $1, $2 }'
git diff --quiet -- ':(glob)**/Cargo.lock' ':(glob)**/package-lock.json' && echo "No lock moved."
echo
echo "### Submodules"
echo
if [ -s "$work/submodules" ]; then cat "$work/submodules"; else echo "No submodule moved."; fi
echo
echo "### derisk bundle"
echo
if [ -s "$work/derisk" ]; then cat "$work/derisk"; else echo "No derisk bundle pin moved."; fi
echo
echo "### Pinned hashes"
echo
grep ' -> ' "$work/hashes" | sed 's/^/- /' || echo "None needed rewriting."
