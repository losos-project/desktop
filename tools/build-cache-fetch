#!/usr/bin/env bash
# Unpack one of CI's build caches into a directory: `losos`, the overlay's
# patched GTK and Qt, losos-ccache in GHCR. It is a zstd tarball split into
# parts of up to 4 GB, ccache.tar.zst.part-00 and on.
#
# The proxy at LOSOS_PROXY_URL serves the parts at
# /build-cache/<name>/<arch>/<part> without a login, so it is tried first,
# and is the way a builder outside CI gets them. Where it has nothing (the
# package is private, or GHCR_REPOSITORY points elsewhere), the same
# artifact comes from GHCR with oras, which the caller has logged in. With
# neither, the build starts cold, which is slower and nothing worse.
#
#   tools/build-cache-fetch losos x86_64 /var/lib/losos-ccache ghcr.io/owner/repo/losos-ccache:x86_64
#
# Needs curl, zstd and tar, oras for the fallback, and sudo, because the
# directory is shared with the Nix build users.
set -euo pipefail

[ $# = 4 ] || { sed -n 's/^#   //p' "$0" >&2; exit 2; }
name=$1 arch=$2 dir=$3 ref=${4,,}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Parts until the first one the proxy does not have. A part that fails any
# other way abandons the proxy rather than unpacking half a tarball.
from_proxy() {
  [ -n "${LOSOS_PROXY_URL:-}" ] || return 1
  local n=0 part status
  while :; do
    part=$(printf 'ccache.tar.zst.part-%02d' "$n")
    status=$(curl -sSL --proto '=https' --retry 3 -o "$work/$part" -w '%{http_code}' \
      "${LOSOS_PROXY_URL%/}/build-cache/$name/$arch/$part") || return 1
    case $status in
      200) n=$((n + 1)) ;;
      404) rm -f "$work/$part"; break ;;
      *) echo "build-cache-fetch: the proxy answered $status for $part" >&2; return 1 ;;
    esac
  done
  [ "$n" -gt 0 ]
}

if from_proxy; then
  echo "Restored $name's cache through the proxy."
else
  rm -f "$work"/ccache.tar.zst.part-*
  if ! oras manifest fetch "$ref" > /dev/null 2>&1; then
    echo "No $name build cache yet; this build starts cold."
    exit 0
  fi
  # GHCR drops a long pull with an HTTP/2 PROTOCOL_ERROR often enough that
  # one failure turned the required prebuild check red. A missing cache only
  # means a cold build, so a pull that still fails starts cold too.
  pulled=0
  for attempt in 1 2 3; do
    if oras pull "$ref" --output "$work"; then
      pulled=1
      break
    fi
    echo "build-cache-fetch: pull of $ref failed (attempt $attempt)" >&2
    rm -f "$work"/ccache.tar.zst.part-*
    sleep $((attempt * 10))
  done
  if [ "$pulled" != 1 ]; then
    echo "Could not download the $name build cache; this build starts cold." >&2
    exit 0
  fi
  echo "Restored $name's cache from GHCR."
fi
cat "$work"/ccache.tar.zst.part-* | sudo tar --zstd -x -C "$dir"
sudo chmod -R a+rwX "$dir"
du -sh "$dir"
