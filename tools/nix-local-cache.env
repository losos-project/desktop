# Local GHCR binary cache (docs/binary-cache.md).
#
# 1. Start the proxy:  ./tools/serve-nix-cache.sh
# 2. Once per machine (multi-user Nix):  ./tools/configure-nix-local-cache.sh
#    NIX_CONFIG is not enough when trusted-users is only root (same as CI's
#    append to /etc/nix/nix.conf).
#
# Builds:  ./tools/nix-with-local-cache.sh build .#installer -L
export GHCR_REPOSITORY="${GHCR_REPOSITORY:-losos-project/desktop}"
export NIX_CACHE_URL="${NIX_CACHE_URL:-http://127.0.0.1:8484}"
export NIX_CACHE_PUBLIC_KEY="${NIX_CACHE_PUBLIC_KEY:-losos-desktop-1:dyW7JUBM96cVu8Ai3qEe0iubFqvI00IcOqyocI2Row0=}"
