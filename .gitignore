# Build output. `plugins/` and `proxy/` are cargo workspaces, and target/ holds
# what they compile. plugins/dist is the result link `just plugins` leaves, a
# symlink, so the pattern has no trailing slash. A compiled copy in git goes
# stale without anyone noticing, so neither is committed.
target/
/plugins/dist

# nix-direnv caches the dev shell in .direnv/, devenv keeps machine state in
# .devenv/, `nix build` leaves result symlinks, and `nix run .#vm` writes a
# disk and a firmware variable store into the directory it ran in.
.direnv/
.devenv/
.devenv.flake.nix
result
result-*
/losos-desktop.qcow2
/losos-desktop-efivars.fd
