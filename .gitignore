# Build output. `plugins/` and `proxy/` are cargo workspaces, and target/ holds
# what they compile. plugins/dist is the result link `just plugins` leaves, a
# symlink, so the pattern has no trailing slash. A compiled copy in git goes
# stale without anyone noticing, so neither is committed.
target/
/plugins/dist

# nix-direnv caches the dev shell in .direnv/, `nix build` leaves result
# symlinks, and `nix run .#vm` writes a disk and a firmware variable store into
# the directory it ran in.
.direnv/
result
result-*
/losos-desktop.qcow2
/losos-desktop-efivars.fd

# Local Nix state, checkouts of flake inputs kept for inspection, and scratch
# disks from Try verification. None of these are sources of this repository.
/.cache/
/derisk/
/mcsapi/
/losos_try/
